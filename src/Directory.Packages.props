<Project>
  <!--
    Central package management. Versions live here; projects name packages
    without versions, so two projects can never disagree about a dependency.

    NuGet audit warnings are errors (Directory.Build.props sets
    TreatWarningsAsErrors). That is deliberate: this codebase handles money and
    personal data, and a vulnerable transitive dependency is exactly the kind
    of problem that stays invisible until it is expensive. When a transitive
    package is flagged, pin the fixed version here rather than suppressing the
    warning.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Identity">
    <!-- ULIDs, not autoincrement, not UUIDv4 (CLAUDE.md 3.2). Belongs in
          Waymark.Application, never Domain: ids come from the IIdGenerator port
          so the synthetic generator stays deterministic (decisions.md D-038). -->
    <PackageVersion Include="Ulid" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup Label="Pseudonymisation">
    <!-- DPAPI, for wrapping the tenant key at LocalMachine scope with entropy
          bound to the install id (decisions.md D-042). Referenced ONLY by
          Waymark.Pseudonymisation: an architecture test fails if any other
          project below the hosts takes a dependency on
          System.Security.Cryptography, because a second place that can compute
          an HMAC is a second place that holds the key. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Sqlite.Core, not Sqlite: the latter hard-depends on
        SQLitePCLRaw.bundle_e_sqlite3, and only one bundle may provide the
        native library in a process. See decisions.md D-015. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- The single native provider for the whole process. Verified end to end
          in D-040: migration, triggers, indexes, STRICT, WAL and rekey all work
          against an encrypted waymark-store.db, and an unencrypted database
          still opens under the same bundle, which is what the POS cache needs. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <!-- Avalonia stays on the mature 11.3 line, not 12.x. The till runs
        unattended in a shop for years between visits, and a UI framework major
        released weeks ago is not the place to be early. Avalonia.Diagnostics
        has no 12.x release yet, which says the same thing.
        Revisit when 12.x has a track record. -->
  <ItemGroup Label="POS">
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- No assertion library pinned. FluentAssertions 8.x is commercially
          licensed and Waymark is a commercial product; plain xUnit Assert
          (decisions.md D-047). -->
  </ItemGroup>
  <ItemGroup Label="Transitive pins for security advisories">
    <!-- Pinned above what a transitive dependency asks for, to clear a NuGet
          audit finding. Each one is removable once the package that pulls it
          ships a fixed version. -->
  </ItemGroup>
</Project>
