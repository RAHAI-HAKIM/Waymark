<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Owns the SQLite files, serves Local Admin, exposes the API the POS calls,
    runs sync and the scheduled jobs. Authoritative for all operational data.
  -->


  <ItemGroup>
    <ProjectReference Include="..\Waymark.Application\Waymark.Application.csproj" />
    <ProjectReference Include="..\Waymark.Persistence\Waymark.Persistence.csproj" />
    <ProjectReference Include="..\Waymark.Pseudonymisation\Waymark.Pseudonymisation.csproj" />
    <ProjectReference Include="..\Waymark.Sync\Waymark.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Staff PINs, Argon2id (D-083). The host is the one place a PIN is checked. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only, and here rather than only in Persistence because the
          EF tools resolve against the STARTUP project. Persistence marks it
          PrivateAssets="all", so it does not flow through the project
          reference. Never shipped: nothing here reaches a published build. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
