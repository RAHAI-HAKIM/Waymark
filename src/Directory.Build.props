<Project>

  <!--
    Settings shared by every project in the solution. Changing the target
    framework is a one-line change here, not twelve.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!--
    Money is never a float (CLAUDE.md 3.1). CS0219-style warnings will not
    catch that, so the rule is carried by review and by the value objects
    themselves; this block only ensures no warning is silently ignored.
  -->
  <PropertyGroup>
    <NoWarn></NoWarn>
  </PropertyGroup>

</Project>
