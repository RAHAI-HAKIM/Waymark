<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tier 1 to tier 2 boundary, isolated so it is a compile-time fact.

    This is the ONLY project that holds the tenant key or computes a pseudonym.
    Waymark.Sync must never reference this project — that missing edge is a
    legal boundary, and an architecture test asserts it (CLAUDE.md 2.1, 3.5).
    It matters more since D-039, not less: this project now holds the key.
  -->


  <ItemGroup>
    <ProjectReference Include="..\Waymark.Domain\Waymark.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI, to wrap the tenant key at LocalMachine scope with entropy bound
         to the install id (D-042). The one package this project needs.

         The Sqlite references that used to sit here are gone: D-039 removed
         waymark-identity.db, W7 confirmed this project opens no database of its
         own, and a project holding the tenant key should carry no dependency it
         cannot justify. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
