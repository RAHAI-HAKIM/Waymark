<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tier 1 to tier 2 boundary, isolated so it is a compile-time fact.

    This is the ONLY project that holds the waymark-identity.db path or opens
    a connection to it. Waymark.Sync must never reference this project — that
    missing edge is a legal boundary, and an architecture test asserts it
    (CLAUDE.md 2.1, 3.4).
  -->


  <ItemGroup>
    <ProjectReference Include="..\Waymark.Domain\Waymark.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The identity file is encrypted with its own key, separate from the
        operational database. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

</Project>
