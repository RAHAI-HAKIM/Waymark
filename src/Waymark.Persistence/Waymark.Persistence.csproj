<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EF Core, SQLite, migrations, repository implementations. The only project
    besides Sync and the hosts allowed to contain SQL.

    Owns waymark-store.db, the only operational database. It does NOT hold
    the tenant key — that lives in Waymark.Pseudonymisation and nowhere else
    (CLAUDE.md 3.5).
  -->


  <ItemGroup>
    <!-- The schema travels inside the assembly, not beside it. See
         SchemaScript and decisions.md D-016. -->
    <EmbeddedResource Include="schema_v7_1.sql" />
    <!-- The append-only triggers travel with the assembly for the same
         reason: a migration that runs without them leaves the database
         with no audit guards, and a missing file would be discovered
         only by a regulator. -->
    <EmbeddedResource Include="triggers.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waymark.Domain\Waymark.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <!-- One bundle for the whole process, and it is the SQLCipher build
          (decisions.md D-015). waymark-store.db is to be keyed with the
          database key (D-042); that key is not implemented yet, so today the
          file is opened without one (O-20). An unencrypted database opens
          under the same bundle, which the POS cache relies on. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>


