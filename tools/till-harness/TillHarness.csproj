<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A hand-run check of the till's window (block A review, 24/09/2026): the real TillWindow,
    drawn headlessly by Avalonia against a fake StoreServer. Outside src/ and outside the
    solution, so nothing ships with it, CI does not run it, and src/Directory.Packages.props
    does not govern it: the two packages below are pinned here, to the till's Avalonia version.
    Whether this becomes a test project is an open question for Hakim (decisions.md O-30).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Waymark.Pos\Waymark.Pos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>

</Project>
