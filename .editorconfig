# Waymark — editor and analyser configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,ts,tsx,js,jsx,css,html,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,axaml,xaml,xml}]
indent_size = 2

[*.sln]
indent_style = tab

[*.py]
indent_size = 4
max_line_length = 100

# ---------------------------------------------------------------------------
# C#
# ---------------------------------------------------------------------------
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:silent

# Naming
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefixed_with_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixed_with_i.required_prefix = I
dotnet_naming_style.prefixed_with_i.capitalization = pascal_case

# A private const, or a private static readonly used as one, reads as a
# constant and takes PascalCase: `Violet`, not `_violet`. These two rules are
# declared BEFORE the instance-field rule below because the first matching rule
# wins — reordering them silently changes what the analyser asks for.
dotnet_naming_rule.private_consts_are_pascal.severity = warning
dotnet_naming_rule.private_consts_are_pascal.symbols = private_consts
dotnet_naming_rule.private_consts_are_pascal.style = pascal
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_consts.required_modifiers = const

dotnet_naming_rule.private_static_readonly_are_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_are_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_are_pascal.style = pascal
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

# Everything else private and field-shaped is mutable instance state: _camelCase.
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Analysers worth failing a build over. Note what is NOT here: no analyser can
# see that a decimal should not have been a double in the first place. The
# money rule (CLAUDE.md §3.1) is carried by the Money value object and by
# review, not by tooling.
dotnet_diagnostic.CA1305.severity = error   # specify IFormatProvider
dotnet_diagnostic.CA1307.severity = error   # specify StringComparison
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait: noisy, no sync context here
dotnet_diagnostic.CA1848.severity = none    # LoggerMessage delegates: premature
# CA1873 is CA1848's companion: it objects to computing a log argument that
# might be discarded. Both are about high-performance logging, and this
# codebase has no hot logging path yet — the calls that exist run once at
# startup. Revisit together if one ever appears in a loop.
dotnet_diagnostic.CA1873.severity = none

# ---------------------------------------------------------------------------
# Domain enums
# ---------------------------------------------------------------------------
[src/Waymark.Domain/Enums/*.cs]
# These members mirror the vocabulary in the schema's CHECK constraints, so a
# data type really is called Integer and a channel really is called Text.
# Renaming them to satisfy the analyser would make the enum harder to check
# against the database, which is the only thing it has to agree with.
dotnet_diagnostic.CA1720.severity = none

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
[src/tests/**/*.cs]
# Test names are sentences: Sync_must_not_reference_Pseudonymisation. A test
# that fails should read like the rule it broke, in the runner output, without
# anyone opening the file. CA1707 is right everywhere else and wrong here.
dotnet_diagnostic.CA1707.severity = none
# Assertion helpers and fixtures are not a public API surface.
dotnet_diagnostic.CA1515.severity = none

# ---------------------------------------------------------------------------
# Generated code
# ---------------------------------------------------------------------------
[src/**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1305.severity = none
